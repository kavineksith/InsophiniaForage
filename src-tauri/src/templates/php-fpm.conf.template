; Generated by InsophiniaForage. Do not edit by hand.
; PHP-FPM pool configuration. Runs as the current user (no root needed).

[global]
pid = {{pid_file}}
error_log = {{error_log}}
daemonize = no
log_level = notice

[www]
user = {{user}}
group = {{group}}
listen = {{php_fpm_socket}}
listen.owner = {{user}}
listen.group = {{group}}
listen.mode = 0660

pm = ondemand
pm.max_children = 5
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 3
pm.max_requests = 500

; Slow log for diagnosing slow scripts.
slowlog = {{slowlog}}
request_slowlog_timeout = 5s

; Capture stdout/stderr to the per-service log file.
catch_workers_output = yes
decorate_workers_output = no

php_admin_value[error_log] = {{php_error_log}}
php_admin_flag[log_errors] = on
php_admin_value[session.save_path] = {{sessions_dir}}
php_admin_value[upload_tmp_dir] = {{upload_tmp_dir}}
php_admin_value[sys_temp_dir] = {{sys_temp_dir}}
