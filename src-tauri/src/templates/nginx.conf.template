# Generated by InsophiniaForage. Do not edit by hand — regenerate via the
# Settings tab. Lines beginning with `##` are comments; `#` are directives.

worker_processes  {{worker_processes}};
error_log  {{error_log}} warn;
pid        {{pid_file}};

events {
    worker_connections  1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    # Log format that includes the project name so we can grep logs per-site.
    log_format  main  '$remote_addr - $remote_user [$time_local] '
                      '"$host" "$request" $status $body_bytes_sent '
                      '"$http_referer" "$http_user_agent"';

    access_log  {{access_log}} main;

    sendfile        on;
    keepalive_timeout  65;
    client_max_body_size  {{client_max_body_size}};

    # Map the Host header to a $project variable. We use the first segment
    # of the host (before the first dot) as the project name.
    map $host $project {
        default                  $host;
        "~^(?P<p>[a-zA-Z0-9_-]+)" $p;
    }

    # phpMyAdmin — fixed project name "pma".
    server {
        listen       {{nginx_http}};
        server_name  pma;
        root         {{www_dir}}/pma;
        index        index.php index.html;

        location / {
            try_files $uri $uri/ /index.php?$args;
        }

        location ~ \.php$ {
            fastcgi_pass  unix:{{php_fpm_socket}};
            fastcgi_index index.php;
            include       fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param HTTPS off;
        }
    }

    # Default catch-all server. Any project name in www/ is served.
    # Per-project PHP version routing: the `map` directive (injected by
    # config_gen.rs at the top of this http block) sets $php_socket based
    # on the $project name. Each project can override its PHP version via
    # the .forge.json file in its www/<name>/ folder.
    server {
        listen       {{nginx_http}} default_server;
        server_name  _;

        # Resolve project root dynamically. If www/$project doesn't exist,
        # return 404.
        root         {{www_dir}}/$project;
        index        index.php index.html;

        location / {
            try_files $uri $uri/ /index.php?$args;
        }

        location ~ \.php$ {
            # $php_socket is set by the map directive. Falls back to the
            # default socket if the project has no override.
            fastcgi_pass  unix:$php_socket;
            fastcgi_index index.php;
            include       fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param HTTPS off;
        }

        # Deny dotfiles.
        location ~ /\. {
            deny all;
        }
    }
}
