# Generated by InsophiniaForage. Do not edit by hand.

[mysqld]
# Networking
port = {{mariadb_port}}
bind-address = 127.0.0.1
socket = {{socket}}
pid-file = {{pid_file}}

# Folders
basedir = {{basedir}}
datadir = {{data_dir}}
tmpdir = {{tmpdir}}

# User (Unix only)
user = {{user}}

# Character set
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Storage
default-storage-engine = InnoDB
innodb_buffer_pool_size = {{innodb_buffer_pool_size}}
innodb_log_file_size = 32M
innodb_flush_log_at_trx_commit = 2
innodb_file_per_table = 1

# Connections (low — this is a single-user dev DB)
max_connections = {{max_connections}}
thread_cache_size = 4
open_files_limit = 1024

# Disable features we don't need (saves RAM)
performance_schema = OFF
skip-name-resolve

# Logging
log_error = {{error_log}}
slow_query_log = 0
long_query_time = 2

# Safety
local-infile = 0
secure-file-priv = NULL

# Default settings for clients
[client]
port = {{mariadb_port}}
socket = {{socket}}
default-character-set = utf8mb4

[mysqldump]
quick
quote-names
max_allowed_packet = 16M

[mysql]
default-character-set = utf8mb4
