{
  "name": "insophinia-forge",
  "version": "0.1.0",
  "private": true,
  "description": "InsophiniaForage — a cross-platform desktop development stack (nginx + PHP + MariaDB + phpMyAdmin + WordPress) built with Tauri.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug",
    "bundle:binaries": "python3 scripts/bundle-binaries.py --all",
    "bundle:php-only": "python3 scripts/bundle-binaries.py --php-only",
    "bundle:list": "python3 scripts/bundle-binaries.py --list-versions",
    "dist": "npm run bundle:binaries && npm run tauri:build"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/cli": "^2.1.0",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "@tauri-apps/plugin-os": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.1",
    "@types/node": "^26.6.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^3.4.14",
    "tslib": "^2.7.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
